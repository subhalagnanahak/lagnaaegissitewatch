# Twilio SMS alert credentials.
# This file is gitignored - never commit it.
# See .env.example for the template with no real values.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# Gate camera - DVR ISAPI snapshot endpoint (channel 3, assumed to be
# the third/gate camera to match cameras.json's channel 1 = fire,
# channel 2 = PPE - VERIFY this is actually the right physical camera
# by opening the URL below in a browser and checking which camera's
# view it shows; change "101" in the URL below to "101"/"201"/"301"
# (channel 1/2/3) until the right one shows up, if not).
#
# Port 15357 is the DVR's HTTP port with NAT's "Mapping Type" set to
# "Manual" (fixed) - should stay this number across DVR reboots now
# that it's no longer "Auto". If it ever stops connecting, check
# Configuration -> Network -> NAT on the DVR hasn't reverted to Auto
# or reassigned - see DVR_SETUP.md's "ISAPI snapshot fallback" section.
GATE_CAMERA_SOURCE=http://admin:Robo%407788@192.168.29.161:15357/ISAPI/Streaming/channels/301/picture
GATE_CAMERA_AUTO_SCAN=true
