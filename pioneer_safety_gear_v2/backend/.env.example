# Copy this file to .env and fill in real values as needed.
# .env itself is gitignored - never commit real credentials.
#
# NONE OF THIS IS REQUIRED. The system runs fully offline out of the
# box: local siren + local alert log (alert_log.jsonl) + the dashboard
# itself all work with zero entries below and zero internet access.

# ------------------------------------------------------------
# OPTIONAL - Twilio SMS. This is the ONLY thing in this project
# that needs internet. Leave all four blank (or delete this file)
# to keep SMS disabled and the deployment fully offline.
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALERT_PHONE_NUMBER=

# ------------------------------------------------------------
# OPTIONAL - alerting behaviour (sensible defaults if omitted)
# ------------------------------------------------------------
# Seconds before the same (camera, zone, incident) can alert again.
ALERT_COOLDOWN=30

# Local audible siren through this machine's own speaker - no
# internet, no cloud account. Set to false to run silent/headless.
LOCAL_SIREN_ENABLED=true

# Spoken-word alert ("Warning. No helmet detected at ...") played
# right after the siren, via the offline espeak-ng/espeak CLI if it's
# installed (apt install espeak-ng). Skipped silently if not installed
# - the siren still fires either way. Set to false to disable outright.
VOICE_ALERTS_ENABLED=true

# Saves a JPEG snapshot of the annotated frame the instant a violation
# alert fires (local disk only - see backend/snapshots/), attached to
# that Alert Log entry as visual proof. Set to false to disable.
SNAPSHOT_ENABLED=true

# How many snapshot files to keep before the oldest are auto-deleted.
# 0 = never prune (keep everything).
MAX_SNAPSHOTS=500

# ------------------------------------------------------------
# OPTIONAL - detection tuning. Both models were trained at
# imgsz=512 (see PPE_train.py / fire_smoke_detection/fire_train.py) -
# leave the inference sizes matched to that unless you retrain.
# ------------------------------------------------------------
# PPE_CONFIDENCE=0.18
# PPE_INFERENCE_SIZE=512

# Fire/smoke is the weaker model and flame/smoke signals are smaller
# and rarer in-frame than a PPE item, so it defaults to a lower
# confidence bar. Raise it if you start getting false positives from
# things like warm lighting, steam, or dust.
# FIRE_CONFIDENCE=0.12
# FIRE_INFERENCE_SIZE=512

# ------------------------------------------------------------
# OPTIONAL - worker face identity (entry gate + live attribution).
# Needs the two model files in backend/models/ - see
# backend/models/README.md for the one-time download. Disables
# itself automatically (face_id.py) if they're missing.
# ------------------------------------------------------------
FACE_ID_ENABLED=true

# SFace's own recommended cosine-similarity match threshold - raise
# for a stricter match (fewer false positives), lower if real workers
# keep coming back UNKNOWN_FACE at the gate.
# FACE_MATCH_THRESHOLD=0.363

# Live-monitoring worker-name attribution only runs face matching on
# a worker who ALREADY has a PPE violation this frame (identity only
# matters for attribution) - set false to also skip it there entirely
# (face ID then only ever runs at the entry gate).
# FACE_ID_ON_VIOLATIONS_ONLY=true

# ------------------------------------------------------------
# OPTIONAL - entry gate (POST /gate/scan). Empty = same four items
# the rest of the site requires (helmet,vest,gloves,boots).
# ------------------------------------------------------------
# GATE_REQUIRED_PPE_ITEMS=helmet,vest,gloves,boots
# GATE_SCAN_COOLDOWN=10

# ------------------------------------------------------------
# OPTIONAL - gate camera (a DVR/NVR channel, e.g. one channel of a
# Hikvision hybrid DVR, read server-side over RTSP - NOT a browser
# webcam; see gate_camera.py's module docstring for why). Leave blank
# to keep POST /gate/scan's manual photo-upload fallback as the only
# way to scan - nothing else in the project needs this.
#
# Typical Hikvision URL shape (works the same for a hybrid DVR's
# analog channels as for separate IP cameras on an NVR):
#   rtsp://<user>:<password>@<dvr-ip>:554/Streaming/Channels/<CH><SS>
# <CH> = channel number (1-4 on a 4-channel DVR), <SS> = "01" for the
# main/high-res stream or "02" for the substream. e.g. channel 3,
# main stream:
#   GATE_CAMERA_SOURCE=rtsp://admin:yourpassword@192.168.1.64:554/Streaming/Channels/301
#
# Can also be a plain local device number instead of a URL - e.g. if
# this channel is fed by a USB capture card instead of RTSP (see
# DVR_SETUP.md's "If the DVR's HEVC stream is fundamentally broken"
# section):
#   GATE_CAMERA_SOURCE=2
# ------------------------------------------------------------
GATE_CAMERA_SOURCE=
# GATE_CAMERA_POLL_INTERVAL=1.0

# If true (the default once GATE_CAMERA_SOURCE is set), the gate
# watches on its own and logs a scan automatically whenever a face
# appears (throttled to roughly once per GATE_SCAN_COOLDOWN) - no one
# has to press anything. Set to false to keep the live preview but
# require an explicit "Capture & Scan" click for every entry.
# GATE_CAMERA_AUTO_SCAN=true

# ------------------------------------------------------------
# OPTIONAL - offline SMS to the supervisor over a GSM/GPRS serial
# modem (SIM800L, SIM900, A9, etc. - any AT-command modem). This is
# SEPARATE from the Twilio SMS above: Twilio needs internet and no
# extra hardware; this needs hardware and no internet. Both can run
# at once, independently. Requires pyserial (see requirements.txt).
# ------------------------------------------------------------
GSM_SMS_ENABLED=false
# GSM_SERIAL_PORT=/dev/ttyUSB0
# GSM_BAUD_RATE=9600
# GSM_SUPERVISOR_NUMBER=      (falls back to ALERT_PHONE_NUMBER above)

# ------------------------------------------------------------
# OPTIONAL - hardware fire/smoke sensor fusion (an MCU reading a
# flame + MQ2-style gas sensor over serial - see fire_sensor.py's
# module docstring for the expected "FLAME:0,SMOKE:123" line format).
# Vision-only fire/smoke detection is completely unaffected either
# way - this only adds a second, agreeing/disagreeing signal once
# connected. Requires pyserial.
# ------------------------------------------------------------
FIRE_SENSOR_ENABLED=false
# FIRE_SENSOR_SERIAL_PORT=/dev/ttyACM0
# FIRE_SENSOR_BAUD_RATE=9600
# FIRE_SENSOR_SMOKE_THRESHOLD=600

# If true, the sensor can raise an alert entirely on its own (no
# vision agreement needed) - a gas/flame sensor often reacts faster
# or sees around an occluded camera angle. Off by default so a
# miscalibrated sensor alone can't spam the siren/SMS.
FIRE_SENSOR_CAN_ALERT_ALONE=false
